# eslint-plugin-jsx-a11y@6.10.2 declares peer `eslint@^3 || ... || ^9`, but we run
# ESLint 10. The plugin loads and works fine (verified), it just hasn't widened
# its declared range yet. Remove this line once it does.
legacy-peer-deps=true

# Keep installs quiet and reproducible
fund=false
audit=false
save-exact=false