{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev server",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": { "regexp": ".*" },
          "endsPattern": { "regexp": "Local:.*(http|https)://\\S+" }
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Build",
      "type": "npm",
      "script": "build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Preview production build",
      "type": "npm",
      "script": "preview",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": { "regexp": ".*" },
          "endsPattern": { "regexp": "Local:.*(http|https)://\\S+" }
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    { "label": "Lint", "type": "npm", "script": "lint", "problemMatcher": ["$eslint-stylish"] },
    {
      "label": "Lint (fix)",
      "type": "npm",
      "script": "lint:fix",
      "problemMatcher": ["$eslint-stylish"]
    },
    { "label": "Format", "type": "npm", "script": "format", "problemMatcher": [] }
  ]
}
